DEPLOY_ENV=production
# Production uses no Cloudflare Tunnel: it sits behind its own reverse proxy (see README, Production)
COMPOSE_FILE=compose.yaml

# Both hostnames are served by production's reverse proxy; fgv-infra-deploy's .env names them SPEXGRAM_WEB_HOST and
# SPEXGRAM_MEDIA_HOST
WEB_HOST=spexgram.example.org
# The API: GraphQL, uploads and /docs
API_HOST=spexgram-api.example.org
MEDIA_HOST=spexgram-media.example.org
KEYCLOAK_HOST=auth.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexgram-server:1.0.0
WEB_IMAGE=bloomper/fgv-spexgram-web:1.0.0
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.29-alpine
# Pinned; upgrade only after fgv-spexgram-server's integration tests ran against the new version
IMMICH_VERSION=v3.3.6
IMMICH_CLIP_MODEL=ViT-L-16-SigLIP2-256__webli
# Limits for Immich's machine learning, which needs a few GB for the multilingual search model
IMMICH_ML_CPUS=2
IMMICH_ML_MEMORY=4g

MYSQL_DATABASE=spexgram
MYSQL_USER=spexgram

# The largest upload the deployment accepts; admins can lower it in the web
MAX_UPLOAD_SIZE=4GB
# Space for the media server's cache of thumbnails and previews
MEDIA_CACHE_SIZE=10g

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
SPEXREGISTER_WEB_URL=https://register.example.org
FGV_REVIVAL_WEB_URL=https://revival.example.org
SPEXIFY_WEB_URL=https://spexify.example.org
SPEXFLIX_WEB_URL=https://spexflix.example.org
ARCHIVE_WEB_URL=https://archive.example.org
API_IMPORT_SAMPLE_DATA=false
API_SAMPLE_DATA_SIZE=small

# Cloudflare Turnstile's site key for visitors' reports; its secret is secrets/API_TURNSTILE_SECRET_KEY
TURNSTILE_SITE_KEY=

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USER=noreply@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexgram@example.org
FEEDBACK_EMAIL=feedback.spexgram@example.org
UMAMI_WEBSITE_ID=
