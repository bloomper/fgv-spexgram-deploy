DEPLOY_ENV=staging
# Staging is published through a Cloudflare Tunnel; production uses no Cloudflare
COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

# The web goes through the Cloudflare Tunnel; the media server is published with Tailscale Funnel by
# fgv-infra-deploy's compose.tailnet.yaml: MEDIA_HOST is its full ts.net name
WEB_HOST=spexgram-staging.example.org
# The API: GraphQL, uploads and /docs; through the tunnel on staging
API_HOST=spexgram-api-staging.example.org
MEDIA_HOST=spexgram-media-staging.tail1234.ts.net
KEYCLOAK_HOST=auth-staging.example.org
KEYCLOAK_REALM=fgv

API_IMAGE=bloomper/fgv-spexgram-server:develop
WEB_IMAGE=bloomper/fgv-spexgram-web:develop
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:1.29-alpine
# Pinned; upgrade only after fgv-spexgram-server's integration tests ran against the new version
IMMICH_VERSION=v3.3.6
IMMICH_CLIP_MODEL=ViT-L-16-SigLIP2-256__webli
# Limits for Immich's machine learning, which needs a few GB for the multilingual search model
IMMICH_ML_CPUS=2
IMMICH_ML_MEMORY=4g

MYSQL_DATABASE=spexgram
MYSQL_USER=spexgram

# The largest upload the deployment accepts; admins can lower it in the web
MAX_UPLOAD_SIZE=4GB
# Space for the media server's cache of thumbnails and previews
MEDIA_CACHE_SIZE=10g

SPEXREGISTER_GRAPHQL_URL=http://spexregister-api:8080/api/graphql
SPEXREGISTER_WEB_URL=https://register-staging.example.org
FGV_REVIVAL_WEB_URL=https://revival-staging.example.org
SPEXIFY_WEB_URL=https://spexify-staging.example.org
SPEXFLIX_WEB_URL=https://spexflix-staging.example.org
ARCHIVE_WEB_URL=https://archive-staging.example.org
API_IMPORT_SAMPLE_DATA=true
API_SAMPLE_DATA_SIZE=small

# Cloudflare Turnstile: its documented test site key, which always passes, with the test secret init-secrets.sh writes
TURNSTILE_SITE_KEY=1x00000000000000000000AA

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_USER=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=noreply@example.org

SUPPORTED_LOCALES=sv,en
DEFAULT_LOCALE=sv
SUPPORT_EMAIL=support.spexgram@example.org
FEEDBACK_EMAIL=feedback.spexgram@example.org
UMAMI_WEBSITE_ID=
